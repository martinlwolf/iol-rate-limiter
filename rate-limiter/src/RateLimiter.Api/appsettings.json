{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "CleanupInterval": "00:01:00",
    "Rules": {
      "login": {
        "Algorithm": "TokenBucket",
        "Limit": 5,
        "Window": "00:01:00"
      },
      "orders": {
        "Algorithm": "SlidingWindowCounter",
        "Limit": 10,
        "Window": "00:01:00"
      }
    }
  }
}
